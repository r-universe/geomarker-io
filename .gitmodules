[submodule ".registry"]
	path = .registry
	url = https://github.com/geomarker-io/geomarker-io.r-universe.dev
	branch = HEAD
[submodule "addr"]
	path = addr
	url = https://github.com/geomarker-io/addr
	branch = v1.3.0
[submodule "appc"]
	path = appc
	url = https://github.com/geomarker-io/appc
	branch = v2.0.1
[submodule "codec"]
	path = codec
	url = https://github.com/geomarker-io/codec
	branch = v3.1.0
[submodule "geomarker"]
	path = geomarker
	url = https://github.com/geomarker-io/geomarker
	branch = v0.1.0
